{
    "name": "nikhilakhiyaniya/laravel-state-machine",
    "description": "Finite state machine for Laravel models with transition guards, hooks, and audit history.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "state-machine",
        "fsm",
        "workflow",
        "eloquent",
        "domain"
    ],
    "authors": [
        {
            "name": "Nikhil Akhiyaniya",
            "email": "nikhilakhiyaniya@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "NikhilAkhiyaniya\\StateMachine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NikhilAkhiyaniya\\StateMachine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NikhilAkhiyaniya\\StateMachine\\StateMachineServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
